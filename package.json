{
  "name": "arkwerx.com",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "build": "ASTRO_TELEMETRY_DISABLED=1 astro check && WRANGLER_SEND_METRICS=false wrangler types worker/worker-configuration.d.ts > /dev/null && tsc -p worker && ASTRO_TELEMETRY_DISABLED=1 astro build",
    "preview": "WRANGLER_SEND_METRICS=false wrangler dev --ip 127.0.0.1 --port 8788",
    "check:dist": "node scripts/check-dist.mjs dist",
    "validate": "html-validate \"dist/**/*.html\"",
    "test": "node --test tests/*.test.ts && playwright test",
    "deploy": "npm run build && npm run check:dist && npm run validate && npm test && WRANGLER_SEND_METRICS=false wrangler deploy"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "astro": "7.3.8"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.64.0",
    "html-validate": "11.16.2",
    "playwright-core": "1.64.0",
    "typescript": "5.9.3",
    "wrangler": "4.149.0"
  }
}

---
import type { Site } from '../content/site';

type Block = Site['selected']['blocks'][number];

interface Props {
  block: Block;
  number: string;
}

const { block, number } = Astro.props;
const id = `p-${block.name.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`;
const STATUSES = ['Shipped', 'Open source', 'In development'] as const;
---

<article class="item block" aria-labelledby={id}>
  <header class="block-head">
    <span class="n hang" aria-hidden="true">{number}</span>
    <h3 id={id}>{block.name}</h3>
    <span class="years">{block.years}</span>
  </header>
  <dl class="fields">
    <div>
      <dt>Role</dt>
      <dd>{block.role}</dd>
    </div>
    <div>
      <dt>What it does</dt>
      <dd>{block.does}</dd>
    </div>
    <div>
      <dt>{block.detail.label}</dt>
      <dd>
        <ul class="bullets">{block.detail.items.map((item) => <li>{item}</li>)}</ul>
        {block.note && <p class="note">{block.note}</p>}
      </dd>
    </div>
    <div>
      <dt>Status</dt>
      <dd>
        <ul class="status">
          {STATUSES.map((s) =>
            block.status.includes(s) ? (
              <li class="on"><span class="box" aria-hidden="true"></span>{s}</li>
            ) : (
              <li class="off" aria-hidden="true"><span class="box"></span>{s}</li>
            ),
          )}
        </ul>
      </dd>
    </div>
    {block.links.length > 0 && (
      <div>
        <dt>Links</dt>
        <dd>
          <ul class="links">
            {block.links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
          </ul>
        </dd>
      </div>
    )}
  </dl>
</article>

---
import Tile from './Tile.astro';
import { site, slug } from '../content/site';

const reveals = ['rv-rise', 'rv-rise', 'rv-wipe', 'rv-wipe', 'rv-rise', 'rv-rise'];
---

<section id="work" class="work" aria-labelledby="work-h">
  <div class="wrap">
    <h2 id="work-h" class="h2">Work</h2>
    <ul class="bento">
      {site.work.map((tile, i) => <Tile tile={tile} reveal={reveals[i % reveals.length]} />)}
    </ul>
    <h3 class="also-h">Also</h3>
    <ul class="also">
      {site.also.map((row) => {
        const Row = row.link ? 'a' : 'div';
        return (
          <li class="rv rv-left">
            <Row class="row" href={row.link?.href}>
              <span class="row-n">{row.name}</span>
              <span class="row-l">{row.line}</span>
              <span class="row-r">{row.role}</span>
              <span class={`chip is-${slug(row.status)}`}>{row.status}</span>
              {row.link ? <svg class="ic row-go" aria-hidden="true"><use href="#i-out"></use></svg> : <span class="row-go"></span>}
            </Row>
          </li>
        );
      })}
    </ul>
  </div>
</section>

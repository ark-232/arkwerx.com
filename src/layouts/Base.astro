---
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/motion.css';
import Sprite from '../components/Sprite.astro';
import { site } from '../content/site';

interface Props {
  title?: string;
  description?: string;
  path: string;
}

const { title, description = site.description, path } = Astro.props;
const full = title ? `${title} · ${site.name}` : `${site.name} · ${site.descriptor}`;
const canonical = new URL(path, Astro.site);
const image = new URL('/og.png', Astro.site);
const nav = [
  { href: '/projects', label: 'Projects' },
  { href: '/members', label: 'Members' },
  { href: '/contact', label: 'Contact' },
];
---

<!doctype html>
<html lang="en" class:list={{ home: path === '/' }}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{full}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {path === '/404' && <meta name="robots" content="noindex" />}
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#1C2A3B" />
    <script is:inline src="/head.js"></script>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href="/fonts/SpectralSC-Medium.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/Spectral-Regular.woff2" as="font" type="font/woff2" crossorigin />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={full} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <Sprite />
    <a class="skip" href="#main">Skip to content</a>
    <header class="mast">
      <div class="wrap">
        <a class="brand" href="/" aria-label={`${site.name}, home`}>
          <img class="seal" src="/seal-reversed.svg" alt="" width="34" height="40" />
          <img class="word" src="/wordmark-reversed.svg" alt="" width="128" height="16" />
        </a>
        <nav aria-label="Site">
          <ul>
            {nav.map((n) => (
              <li>
                <a href={n.href} aria-current={path === n.href ? 'page' : undefined}>
                  {n.label}{path === n.href && <span class="cur" aria-hidden="true"></span>}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="foot">
      <div class="wrap">
        <img class="foot-seal" src="/seal-white.svg" alt="" width="52" height="62" loading="lazy" />
        <p>
          <span>{site.name} LLC</span>
          <span>Est. {site.established}</span>
          <span class="motto">Ultra fines</span>
          <a href="/privacy">Privacy</a>
          <a href="/terms">Terms</a>
          <a href={site.source.href}>{site.source.label}</a>
        </p>
      </div>
    </footer>
    <script>
      import '../scripts/motion';
    </script>
  </body>
</html>

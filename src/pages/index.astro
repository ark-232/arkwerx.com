---
import Base from '../layouts/Base.astro';
import SealMark from '../components/SealMark.astro';
import { site } from '../content/site';
import '../styles/pages.css';

const words = (text: string) => text.split(' ');
const rows = [
  { no: 'I', href: '/projects', label: 'Projects', text: 'Works and collaborations.' },
  { no: 'II', href: '/members', label: 'Members', text: 'The people of the firm.' },
  { no: 'III', href: '/contact', label: 'Contact', text: site.contact },
];
---

<Base path="/">
  <section class="front wrap">
    <div>
      <p class="kicker">Est. {site.established}</p>
      <h1 class="display heading">
        {words(`${site.descriptor}.`).map((w, i) => <>{i > 0 && ' '}<span class="w">{w}</span></>)}
      </h1>
      <p class="lede stream">
        {words(site.description).map((w, i) => <>{i > 0 && ' '}<span class="w">{w}</span></>)}
      </p>
    </div>
    <SealMark />
  </section>

  <nav class="rows wrap" aria-label="Sections">
    <ul>
      {rows.map((r) => (
        <li class="rv">
          <a href={r.href}>
            <span class="no">{r.no}</span>
            <span class="name">{r.label}</span>
            <span class="text">{r.text}</span>
            <svg class="ic" aria-hidden="true"><use href="#i-out"></use></svg>
          </a>
        </li>
      ))}
    </ul>
  </nav>
</Base>

---
import Base from '../layouts/Base.astro';
import { site } from '../content/site';
import '../styles/pages.css';

const rows = [
  { no: 'I', href: '/projects', label: 'Projects', text: 'Works and collaborations.' },
  { no: 'II', href: '/members', label: 'Members', text: 'The people of the firm.' },
  { no: 'III', href: '/contact', label: 'Contact', text: site.contact },
];
---

<Base path="/">
  <section class="front wrap">
    <div>
      <p class="kicker">Est. {site.established}</p>
      <h1 class="display">{site.descriptor}.</h1>
      <p class="lede">{site.description}</p>
    </div>
    <img class="front-seal" src="/seal.svg" alt="The ArkWerx seal: a white eagle on an oxblood shield." width="300" height="356" fetchpriority="high" />
  </section>

  <nav class="rows wrap" aria-label="Sections">
    <ul>
      {rows.map((r) => (
        <li class="rv">
          <a href={r.href}>
            <span class="no">{r.no}</span>
            <span class="name">{r.label}</span>
            <span class="text">{r.text}</span>
            <svg class="ic" aria-hidden="true"><use href="#i-out"></use></svg>
          </a>
        </li>
      ))}
    </ul>
  </nav>

  <div class="wrap"><p class="seal-note">{site.seal}</p></div>

  <script>
    import '../scripts/motion';
  </script>
</Base>

---
import Base from '../layouts/Base.astro';
import { site } from '../content/site';
import '../styles/pages.css';
---

<Base title="Members" path="/members">
  <div class="page wrap">
    <h1 class="display">Members</h1>
    <ul class="members">
      {site.members.map((m) => (
        <li class="member rv">
          <div class="who">
            <h2>{m.name}</h2>
            <p class="title">{m.title}</p>
            {m.links.length > 0 && (
              <ul class="mlinks">
                {m.links.map((l) => <li><a href={l.href}>{l.label}<svg class="ic" aria-hidden="true"><use href="#i-out"></use></svg></a></li>)}
              </ul>
            )}
          </div>
          <p class="bio">{m.bio}</p>
        </li>
      ))}
    </ul>
  </div>

</Base>

---
import Base from '../layouts/Base.astro';
import '../styles/pages.css';
---

<Base title="Privacy" path="/privacy">
  <div class="page wrap prose">
    <h1 class="display">Privacy</h1>
    <p>This site sets no cookies and runs no analytics or trackers. Everything it loads comes from this site.</p>
    <p>The <a href="/contact">contact form</a> collects your name, email address, topic and message. The message is emailed to the firm and kept in that mailbox. It is not sold, shared or used for marketing.</p>
    <p>Cloudflare hosts the site and handles connection data such as IP addresses to deliver pages, limit abuse of the form and keep the site secure.</p>
    <p>To have a message deleted, ask through the contact page.</p>
    <p class="updated">Updated 6 November 2026</p>
  </div>
</Base>

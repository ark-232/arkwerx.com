{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "arkwerx-com",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "arkwerx.com", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "404-page"
  },
  "send_email": [{ "name": "EMAIL", "allowed_sender_addresses": ["form@arkwerx.com"] }],
  "ratelimits": [
    { "name": "CONTACT_LIMIT", "namespace_id": "1001", "simple": { "limit": 3, "period": 60 } },
    { "name": "CONTACT_LIMIT_ALL", "namespace_id": "1002", "simple": { "limit": 10, "period": 60 } }
  ],
  "observability": { "enabled": true, "head_sampling_rate": 1 }
}
